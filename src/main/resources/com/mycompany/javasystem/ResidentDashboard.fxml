<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mycompany.javasystem.ResidentDashboardController"
            prefHeight="700.0" prefWidth="1100.0"
            style="-fx-background-color: #f4f4f4;">

    <!-- TOP BAR -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="65"       
              style="-fx-background-color: #ffffff;
                     -fx-border-color: #e8e8e8;
                     -fx-border-width: 0 0 1 0;
                     -fx-padding: 0 24;">

            <HBox alignment="CENTER_LEFT" spacing="12" HBox.hgrow="ALWAYS">
                <Circle radius="18" fill="#2d2d2d"/>
                <VBox alignment="CENTER_LEFT" spacing="2">
                    <Label text="Barangay San Isidro"
                           style="-fx-font-size: 15px; -fx-font-weight: bold;
                                  -fx-text-fill: #1a1a1a;"/>
                    <Label text="Resident Portal"
                           style="-fx-font-size: 10px; -fx-text-fill: #aaaaaa;"/>
                </VBox>
            </HBox>

            <HBox alignment="CENTER_RIGHT" spacing="12">
                <StackPane>
                    <Button fx:id="alertsButton" text="🔔  Alerts" onAction="#showNotifications"
                            style="-fx-background-color: #f4f4f4;
                                   -fx-text-fill: #333333;
                                   -fx-font-size: 12px;
                                   -fx-background-radius: 20;
                                   -fx-border-radius: 20;
                                   -fx-border-color: #e0e0e0;
                                   -fx-border-width: 1;
                                   -fx-padding: 8 16;
                                   -fx-cursor: hand;"/>
                    <Label fx:id="alertBadge" text="0" visible="false"
                           style="-fx-background-color: #e53935;
                                  -fx-text-fill: #ffffff;
                                  -fx-font-size: 9px;
                                  -fx-font-weight: bold;
                                  -fx-background-radius: 10;
                                  -fx-padding: 2 5;
                                  -fx-min-width: 16;
                                  -fx-min-height: 16;"
                           StackPane.alignment="TOP_RIGHT"/>
                </StackPane>

                <HBox alignment="CENTER" spacing="8" onMouseClicked="#goToMyProfile"
                      style="-fx-background-color: #f4f4f4;
                             -fx-background-radius: 20;
                             -fx-border-radius: 20;
                             -fx-border-color: #e0e0e0;
                             -fx-border-width: 1;
                             -fx-padding: 6 16;
                             -fx-cursor: hand;">
                    <StackPane>
                        <Circle fx:id="topBarProfileCircle" radius="14" fill="#2d2d2d"/>
                        <Label fx:id="topBarProfileInitials" text="R"
                               style="-fx-font-size: 10px; -fx-font-weight: bold;
                                      -fx-text-fill: #ffffff;"/>
                    </StackPane>
                    <Label fx:id="residentNameLabel" text="Resident Name"
                           style="-fx-font-size: 12px; -fx-font-weight: bold;
                                  -fx-text-fill: #1a1a1a;"/>
                </HBox>

                <Button fx:id="logoutButton" text="← Logout" onAction="#handleLogout"
                    style="-fx-background-color: #ffffff;
                        -fx-text-fill: #555555;
                        -fx-font-size: 12px;
                        -fx-background-radius: 8;
                        -fx-border-radius: 8;
                        -fx-border-color: #e0e0e0;
                        -fx-border-width: 1;
                        -fx-padding: 8 16;
                        -fx-cursor: hand;"/>
            </HBox>
        </HBox>
    </top>

    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="220" prefHeight="700"
              style="-fx-background-color: #ffffff;
                     -fx-border-color: #e8e8e8;
                     -fx-border-width: 0 1 0 0;
                     -fx-padding: 20 12;">

            <Label text="MAIN"
                   style="-fx-font-size: 10px; -fx-font-weight: bold;
                          -fx-text-fill: #bbbbbb; -fx-padding: 8 12 6 12;"/>

            <Button text="🏠   Dashboard" maxWidth="Infinity"
                    style="-fx-background-color: #2d2d2d;
                           -fx-text-fill: #ffffff;
                           -fx-font-size: 13px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-padding: 11 16;
                           -fx-alignment: CENTER_LEFT;
                           -fx-cursor: hand;">
                <VBox.margin><Insets bottom="4"/></VBox.margin>
            </Button>

            <Button text="📄   My Documents" maxWidth="Infinity"
                    onAction="#goToMyDocuments"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #555555;
                           -fx-font-size: 13px;
                           -fx-background-radius: 8;
                           -fx-padding: 11 16;
                           -fx-alignment: CENTER_LEFT;
                           -fx-cursor: hand;"
                    onMouseEntered="#handleMouseEntered"
                    onMouseExited="#handleMouseExited">
                <VBox.margin><Insets bottom="4"/></VBox.margin>
            </Button>

            <Button text="📝   Request Document" maxWidth="Infinity"
                    onAction="#goToRequestDocument"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #555555;
                           -fx-font-size: 13px;
                           -fx-background-radius: 8;
                           -fx-padding: 11 16;
                           -fx-alignment: CENTER_LEFT;
                           -fx-cursor: hand;"
                    onMouseEntered="#handleMouseEntered"
                    onMouseExited="#handleMouseExited">
                <VBox.margin><Insets bottom="16"/></VBox.margin>
            </Button>

            <Label text="SERVICES"
                   style="-fx-font-size: 10px; -fx-font-weight: bold;
                          -fx-text-fill: #bbbbbb; -fx-padding: 8 12 6 12;"/>

            <Button text="💳   Payments" maxWidth="Infinity"
                    onAction="#goToPayments"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #555555;
                           -fx-font-size: 13px;
                           -fx-background-radius: 8;
                           -fx-padding: 11 16;
                           -fx-alignment: CENTER_LEFT;
                           -fx-cursor: hand;"
                    onMouseEntered="#handleMouseEntered"
                    onMouseExited="#handleMouseExited">
                <VBox.margin><Insets bottom="4"/></VBox.margin>
            </Button>

            <Button text="📢   My Complaints" maxWidth="Infinity"
                    onAction="#goToComplaints"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #555555;
                           -fx-font-size: 13px;
                           -fx-background-radius: 8;
                           -fx-padding: 11 16;
                           -fx-alignment: CENTER_LEFT;
                           -fx-cursor: hand;"
                    onMouseEntered="#handleMouseEntered"
                    onMouseExited="#handleMouseExited">
                <VBox.margin><Insets bottom="4"/></VBox.margin>
            </Button>

            <Button text="📣   Announcements" maxWidth="Infinity"
                    onAction="#goToAnnouncements"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #555555;
                           -fx-font-size: 13px;
                           -fx-background-radius: 8;
                           -fx-padding: 11 16;
                           -fx-alignment: CENTER_LEFT;
                           -fx-cursor: hand;"
                    onMouseEntered="#handleMouseEntered"
                    onMouseExited="#handleMouseExited">
                <VBox.margin><Insets bottom="16"/></VBox.margin>
            </Button>

            <Label text="ACCOUNT"
                   style="-fx-font-size: 10px; -fx-font-weight: bold;
                          -fx-text-fill: #bbbbbb; -fx-padding: 8 12 6 12;"/>

            <Button text="👤   My Profile" maxWidth="Infinity"
                    onAction="#goToMyProfile"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #555555;
                           -fx-font-size: 13px;
                           -fx-background-radius: 8;
                           -fx-padding: 11 16;
                           -fx-alignment: CENTER_LEFT;
                           -fx-cursor: hand;"
                    onMouseEntered="#handleMouseEntered"
                    onMouseExited="#handleMouseExited">
                <VBox.margin><Insets bottom="4"/></VBox.margin>
            </Button>

            <!-- Spacer to push Settings to bottom -->
            <Region VBox.vgrow="ALWAYS"/>

            <Button text="⚙   Settings" maxWidth="Infinity"
                    onAction="#goToSettings"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #555555;
                           -fx-font-size: 13px;
                           -fx-background-radius: 8;
                           -fx-padding: 11 16;
                           -fx-alignment: CENTER_LEFT;
                           -fx-cursor: hand;"
                    onMouseEntered="#handleMouseEntered"
                    onMouseExited="#handleMouseExited">
                <VBox.margin><Insets bottom="4"/></VBox.margin>
            </Button>

        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: #f7f8fa;
                           -fx-background: #f7f8fa;
                           -fx-border-color: transparent;">
            <VBox spacing="20" style="-fx-padding: 28 28 28 28;">

                <!-- Welcome Banner -->
                <HBox alignment="CENTER_LEFT" spacing="0"
                      style="-fx-background-color: #1e1e2e;
                             -fx-background-radius: 14;
                             -fx-padding: 28 32;">
                    <VBox HBox.hgrow="ALWAYS" spacing="6">
                        <Label fx:id="welcomeLabel" text="Good morning, Resident 👋"
                               style="-fx-font-size: 20px; -fx-font-weight: bold;
                                      -fx-text-fill: #ffffff;"/>
                        <Label text="Here's an overview of your barangay activity."
                               style="-fx-font-size: 12px; -fx-text-fill: #8888aa;"/>
                        <HBox spacing="10" style="-fx-padding: 14 0 0 0;">
                            <Button text="Request Document" onAction="#goToRequestDocument"
                                    style="-fx-background-color: #ffffff;
                                           -fx-text-fill: #1e1e2e;
                                           -fx-font-size: 12px;
                                           -fx-font-weight: bold;
                                           -fx-background-radius: 8;
                                           -fx-border-radius: 8;
                                           -fx-padding: 9 18;
                                           -fx-cursor: hand;"/>
                            <Button text="View Documents" onAction="#goToMyDocuments"
                                    style="-fx-background-color: #2e2e45;
                                           -fx-text-fill: #ccccee;
                                           -fx-font-size: 12px;
                                           -fx-background-radius: 8;
                                           -fx-border-radius: 8;
                                           -fx-padding: 9 18;
                                           -fx-cursor: hand;"/>
                        </HBox>
                    </VBox>
                </HBox>

                <!-- Stats Row -->
                <HBox spacing="14">

                    <!-- Pending Requests -->
                    <VBox HBox.hgrow="ALWAYS" spacing="4"
                          style="-fx-background-color: #ffffff;
                                 -fx-background-radius: 12;
                                 -fx-border-color: #ebebf0;
                                 -fx-border-width: 1;
                                 -fx-padding: 18 20;">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="⏳"
                                   style="-fx-font-size: 16px;"/>
                            <Label text="Pending"
                                   style="-fx-font-size: 11px; -fx-text-fill: #999999;"/>
                        </HBox>
                        <Label text="2"
                               style="-fx-font-size: 30px; -fx-font-weight: bold;
                                      -fx-text-fill: #1a1a2e;">
                            <VBox.margin><Insets top="2"/></VBox.margin>
                        </Label>
                        <Label text="In processing"
                               style="-fx-background-color: #fff8e6;
                                      -fx-text-fill: #c47f00;
                                      -fx-font-size: 10px;
                                      -fx-font-weight: bold;
                                      -fx-background-radius: 5;
                                      -fx-padding: 3 8;"/>
                    </VBox>

                    <!-- Completed Documents -->
                    <VBox HBox.hgrow="ALWAYS" spacing="4"
                          style="-fx-background-color: #ffffff;
                                 -fx-background-radius: 12;
                                 -fx-border-color: #ebebf0;
                                 -fx-border-width: 1;
                                 -fx-padding: 18 20;">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="✅"
                                   style="-fx-font-size: 16px;"/>
                            <Label text="Completed"
                                   style="-fx-font-size: 11px; -fx-text-fill: #999999;"/>
                        </HBox>
                        <Label text="8"
                               style="-fx-font-size: 30px; -fx-font-weight: bold;
                                      -fx-text-fill: #1a1a2e;">
                            <VBox.margin><Insets top="2"/></VBox.margin>
                        </Label>
                        <Label text="Ready for pickup"
                               style="-fx-background-color: #edf7ed;
                                      -fx-text-fill: #2e7d32;
                                      -fx-font-size: 10px;
                                      -fx-font-weight: bold;
                                      -fx-background-radius: 5;
                                      -fx-padding: 3 8;"/>
                    </VBox>

                    <!-- Active Complaints -->
                    <VBox HBox.hgrow="ALWAYS" spacing="4"
                          style="-fx-background-color: #ffffff;
                                 -fx-background-radius: 12;
                                 -fx-border-color: #ebebf0;
                                 -fx-border-width: 1;
                                 -fx-padding: 18 20;">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="📢"
                                   style="-fx-font-size: 16px;"/>
                            <Label text="Complaints"
                                   style="-fx-font-size: 11px; -fx-text-fill: #999999;"/>
                        </HBox>
                        <Label text="1"
                               style="-fx-font-size: 30px; -fx-font-weight: bold;
                                      -fx-text-fill: #1a1a2e;">
                            <VBox.margin><Insets top="2"/></VBox.margin>
                        </Label>
                        <Label text="Under review"
                               style="-fx-background-color: #e8f0fe;
                                      -fx-text-fill: #1a56cc;
                                      -fx-font-size: 10px;
                                      -fx-font-weight: bold;
                                      -fx-background-radius: 5;
                                      -fx-padding: 3 8;"/>
                    </VBox>

                    <!-- Unread Announcements -->
                    <VBox HBox.hgrow="ALWAYS" spacing="4"
                          style="-fx-background-color: #ffffff;
                                 -fx-background-radius: 12;
                                 -fx-border-color: #ebebf0;
                                 -fx-border-width: 1;
                                 -fx-padding: 18 20;">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="📣"
                                   style="-fx-font-size: 16px;"/>
                            <Label text="Announcements"
                                   style="-fx-font-size: 11px; -fx-text-fill: #999999;"/>
                        </HBox>
                        <Label text="3"
                               style="-fx-font-size: 30px; -fx-font-weight: bold;
                                      -fx-text-fill: #1a1a2e;">
                            <VBox.margin><Insets top="2"/></VBox.margin>
                        </Label>
                        <Label text="1 urgent"
                               style="-fx-background-color: #fdecea;
                                      -fx-text-fill: #c62828;
                                      -fx-font-size: 10px;
                                      -fx-font-weight: bold;
                                      -fx-background-radius: 5;
                                      -fx-padding: 3 8;"/>
                    </VBox>

                </HBox>

                <!-- Bottom Row: Document Requests + Announcements -->
                <HBox spacing="14" alignment="TOP_LEFT">

                    <!-- My Document Requests -->
                    <VBox HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #ffffff;
                                 -fx-background-radius: 12;
                                 -fx-border-color: #ebebf0;
                                 -fx-border-width: 1;
                                 -fx-padding: 20 22;">

                        <!-- Section header -->
                        <HBox alignment="CENTER_LEFT" style="-fx-padding: 0 0 14 0;
                                                              -fx-border-color: #f2f2f5;
                                                              -fx-border-width: 0 0 1 0;">
                            <VBox HBox.hgrow="ALWAYS" spacing="2">
                                <Label text="Document Requests"
                                       style="-fx-font-size: 13px; -fx-font-weight: bold;
                                              -fx-text-fill: #1a1a2e;"/>
                                <Label text="Your recent submissions"
                                       style="-fx-font-size: 10px; -fx-text-fill: #aaaaaa;"/>
                            </VBox>
                            <Button text="View All →" onAction="#goToMyDocuments"
                                    style="-fx-background-color: transparent;
                                           -fx-text-fill: #5555cc;
                                           -fx-font-size: 11px;
                                           -fx-background-radius: 6;
                                           -fx-padding: 5 0;
                                           -fx-cursor: hand;"/>
                        </HBox>

                        <!-- Column headers -->
                        <HBox style="-fx-padding: 10 0 8 0;">
                            <Label text="Document" prefWidth="190"
                                   style="-fx-font-size: 10px; -fx-font-weight: bold;
                                          -fx-text-fill: #bbbbcc; -fx-letter-spacing: 0.5;"/>
                            <Label text="Date" prefWidth="120"
                                   style="-fx-font-size: 10px; -fx-font-weight: bold;
                                          -fx-text-fill: #bbbbcc;"/>
                            <Label text="Status" prefWidth="100"
                                   style="-fx-font-size: 10px; -fx-font-weight: bold;
                                          -fx-text-fill: #bbbbcc;"/>
                        </HBox>

                        <!-- Row 1 -->
                        <HBox alignment="CENTER_LEFT"
                              style="-fx-padding: 10 0;
                                     -fx-border-color: #f5f5f8;
                                     -fx-border-width: 0 0 1 0;">
                            <Label text="Barangay Clearance" prefWidth="190"
                                   style="-fx-font-size: 12px; -fx-text-fill: #2a2a3e; -fx-font-weight: bold;"/>
                            <Label text="June 13, 2024" prefWidth="120"
                                   style="-fx-font-size: 12px; -fx-text-fill: #777788;"/>
                            <Label text="Processing"
                                   style="-fx-background-color: #e8f0fe;
                                          -fx-text-fill: #1a56cc;
                                          -fx-font-size: 10px;
                                          -fx-font-weight: bold;
                                          -fx-background-radius: 20;
                                          -fx-padding: 3 10;"/>
                        </HBox>

                        <!-- Row 2 -->
                        <HBox alignment="CENTER_LEFT"
                              style="-fx-padding: 10 0;
                                     -fx-border-color: #f5f5f8;
                                     -fx-border-width: 0 0 1 0;">
                            <Label text="Certificate of Residency" prefWidth="190"
                                   style="-fx-font-size: 12px; -fx-text-fill: #2a2a3e; -fx-font-weight: bold;"/>
                            <Label text="June 12, 2024" prefWidth="120"
                                   style="-fx-font-size: 12px; -fx-text-fill: #777788;"/>
                            <Label text="Ready"
                                   style="-fx-background-color: #edf7ed;
                                          -fx-text-fill: #2e7d32;
                                          -fx-font-size: 10px;
                                          -fx-font-weight: bold;
                                          -fx-background-radius: 20;
                                          -fx-padding: 3 10;"/>
                        </HBox>

                        <!-- Row 3 -->
                        <HBox alignment="CENTER_LEFT"
                              style="-fx-padding: 10 0;
                                     -fx-border-color: #f5f5f8;
                                     -fx-border-width: 0 0 1 0;">
                            <Label text="Indigency Certificate" prefWidth="190"
                                   style="-fx-font-size: 12px; -fx-text-fill: #2a2a3e; -fx-font-weight: bold;"/>
                            <Label text="June 10, 2024" prefWidth="120"
                                   style="-fx-font-size: 12px; -fx-text-fill: #777788;"/>
                            <Label text="Released"
                                   style="-fx-background-color: #f3eeff;
                                          -fx-text-fill: #6a1fb5;
                                          -fx-font-size: 10px;
                                          -fx-font-weight: bold;
                                          -fx-background-radius: 20;
                                          -fx-padding: 3 10;"/>
                        </HBox>

                        <!-- Row 4 -->
                        <HBox alignment="CENTER_LEFT" style="-fx-padding: 10 0 0 0;">
                            <Label text="Business Permit" prefWidth="190"
                                   style="-fx-font-size: 12px; -fx-text-fill: #2a2a3e; -fx-font-weight: bold;"/>
                            <Label text="June 8, 2024" prefWidth="120"
                                   style="-fx-font-size: 12px; -fx-text-fill: #777788;"/>
                            <Label text="Released"
                                   style="-fx-background-color: #f3eeff;
                                          -fx-text-fill: #6a1fb5;
                                          -fx-font-size: 10px;
                                          -fx-font-weight: bold;
                                          -fx-background-radius: 20;
                                          -fx-padding: 3 10;"/>
                        </HBox>

                    </VBox>

                    <!-- Announcements Panel -->
                    <VBox prefWidth="290"
                          style="-fx-background-color: #ffffff;
                                 -fx-background-radius: 12;
                                 -fx-border-color: #ebebf0;
                                 -fx-border-width: 1;
                                 -fx-padding: 20 22;">

                        <!-- Header -->
                        <HBox alignment="CENTER_LEFT" style="-fx-padding: 0 0 14 0;
                                                              -fx-border-color: #f2f2f5;
                                                              -fx-border-width: 0 0 1 0;">
                            <VBox HBox.hgrow="ALWAYS" spacing="2">
                                <Label text="Announcements"
                                       style="-fx-font-size: 13px; -fx-font-weight: bold;
                                              -fx-text-fill: #1a1a2e;"/>
                                <Label text="Latest from the barangay"
                                       style="-fx-font-size: 10px; -fx-text-fill: #aaaaaa;"/>
                            </VBox>
                            <Button text="View All →" onAction="#goToAnnouncements"
                                    style="-fx-background-color: transparent;
                                           -fx-text-fill: #5555cc;
                                           -fx-font-size: 11px;
                                           -fx-padding: 5 0;
                                           -fx-cursor: hand;"/>
                        </HBox>

                        <!-- Urgent item -->
                        <VBox spacing="3"
                              style="-fx-background-color: #fff5f5;
                                     -fx-background-radius: 8;
                                     -fx-border-color: #ffcccc;
                                     -fx-border-width: 1;
                                     -fx-border-radius: 8;
                                     -fx-padding: 12;">
                            <HBox alignment="CENTER_LEFT" spacing="6">
                                <Label text="URGENT"
                                       style="-fx-background-color: #fdecea;
                                              -fx-text-fill: #c62828;
                                              -fx-font-size: 9px;
                                              -fx-font-weight: bold;
                                              -fx-background-radius: 4;
                                              -fx-padding: 2 6;"/>
                            </HBox>
                            <Label text="Typhoon Advisory – Signal No. 1"
                                   style="-fx-font-size: 12px; -fx-font-weight: bold;
                                          -fx-text-fill: #2a2a3e;"
                                   wrapText="true">
                                <VBox.margin><Insets top="4"/></VBox.margin>
                            </Label>
                            <Label text="Today, 9:00 AM"
                                   style="-fx-font-size: 10px; -fx-text-fill: #c62828;"/>
                            <Label text="Residents advised to stay indoors and prepare emergency kits."
                                   style="-fx-font-size: 11px; -fx-text-fill: #777788;"
                                   wrapText="true">
                                <VBox.margin><Insets top="2"/></VBox.margin>
                            </Label>
                        </VBox>
                        <VBox.margin><Insets bottom="10"/></VBox.margin>

                        <!-- Health item -->
                        <VBox spacing="3"
                              style="-fx-border-color: #f2f2f5;
                                     -fx-border-width: 0 0 1 0;
                                     -fx-padding: 0 0 12 0;">
                            <HBox alignment="CENTER_LEFT" spacing="6">
                                <Label text="HEALTH"
                                       style="-fx-background-color: #edf7ed;
                                              -fx-text-fill: #2e7d32;
                                              -fx-font-size: 9px;
                                              -fx-font-weight: bold;
                                              -fx-background-radius: 4;
                                              -fx-padding: 2 6;"/>
                            </HBox>
                            <Label text="Free Vaccination Drive – June 15"
                                   style="-fx-font-size: 12px; -fx-font-weight: bold;
                                          -fx-text-fill: #2a2a3e;"
                                   wrapText="true">
                                <VBox.margin><Insets top="4"/></VBox.margin>
                            </Label>
                            <Label text="June 12"
                                   style="-fx-font-size: 10px; -fx-text-fill: #aaaaaa;"/>
                            <Label text="Anti-flu vaccines at Barangay Health Center."
                                   style="-fx-font-size: 11px; -fx-text-fill: #777788;"
                                   wrapText="true">
                                <VBox.margin><Insets top="2"/></VBox.margin>
                            </Label>
                        </VBox>
                        <VBox.margin><Insets bottom="10"/></VBox.margin>

                        <!-- General item -->
                        <VBox spacing="3" style="-fx-padding: 0;">
                            <HBox alignment="CENTER_LEFT" spacing="6">
                                <Label text="GENERAL"
                                       style="-fx-background-color: #f0f0f5;
                                              -fx-text-fill: #666688;
                                              -fx-font-size: 9px;
                                              -fx-font-weight: bold;
                                              -fx-background-radius: 4;
