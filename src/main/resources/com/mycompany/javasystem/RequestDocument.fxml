<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mycompany.javasystem.Residents_RequestDocumentController"
            prefHeight="700.0" prefWidth="1100.0"
            style="-fx-background-color: #f4f4f4;">

    <!-- TOP BAR -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="65"
              style="-fx-background-color: #ffffff;
                     -fx-border-color: #e8e8e8;
                     -fx-border-width: 0 0 1 0;
                     -fx-padding: 0 24;">
            <HBox alignment="CENTER_LEFT" spacing="12" HBox.hgrow="ALWAYS">
                <Circle radius="18" fill="#2d2d2d"/>
                <VBox alignment="CENTER_LEFT" spacing="2">
                    <Label text="Barangay San Isidro"
                           style="-fx-font-size: 15px; -fx-font-weight: bold;
                                  -fx-text-fill: #1a1a1a;"/>
                    <Label text="Resident Portal"
                           style="-fx-font-size: 10px; -fx-text-fill: #aaaaaa;"/>
                </VBox>
            </HBox>
            <HBox alignment="CENTER_RIGHT" spacing="12">
                <Button text="🔔  Alerts"
                        style="-fx-background-color: #f4f4f4;
                               -fx-text-fill: #333333;
                               -fx-font-size: 12px;
                               -fx-background-radius: 20;
                               -fx-border-radius: 20;
                               -fx-border-color: #e0e0e0;
                               -fx-border-width: 1;
                               -fx-padding: 8 16;
                               -fx-cursor: hand;"/>
                <HBox alignment="CENTER" spacing="8"
                      style="-fx-background-color: #f4f4f4;
                             -fx-background-radius: 20;
                             -fx-border-radius: 20;
                             -fx-border-color: #e0e0e0;
                             -fx-border-width: 1;
                             -fx-padding: 6 16;">
                    <StackPane>
                        <Circle fx:id="topBarProfileCircle" radius="14" fill="#2d2d2d"/>
                        <Label fx:id="topBarProfileInitials" text="R"
                               style="-fx-font-size: 10px; -fx-font-weight: bold;
                                      -fx-text-fill: #ffffff;"/>
                    </StackPane>
                    <Label fx:id="residentNameLabel" text="Resident"
                           style="-fx-font-size: 12px; -fx-font-weight: bold;
                                  -fx-text-fill: #1a1a1a;"/>
                </HBox>
                <Button fx:id="logoutButton" text="← Logout" onAction="#handleLogout"
                        style="-fx-background-color: #ffffff;
                               -fx-text-fill: #555555;
                               -fx-font-size: 12px;
                               -fx-background-radius: 8;
                               -fx-border-radius: 8;
                               -fx-border-color: #e0e0e0;
                               -fx-border-width: 1;
                               -fx-padding: 8 16;
                               -fx-cursor: hand;"/>
            </HBox>
        </HBox>
    </top>

    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="220" prefHeight="700"
              style="-fx-background-color: #ffffff;
                     -fx-border-color: #e8e8e8;
                     -fx-border-width: 0 1 0 0;
                     -fx-padding: 20 12;">

            <Label text="MAIN"
                   style="-fx-font-size: 10px; -fx-font-weight: bold;
                          -fx-text-fill: #bbbbbb; -fx-padding: 8 12 6 12;"/>

            <Button text="🏠   Dashboard" maxWidth="Infinity"
                    onAction="#goToDashboard"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #555555;
                           -fx-font-size: 13px;
                           -fx-background-radius: 8;
                           -fx-padding: 11 16;
                           -fx-alignment: CENTER_LEFT;
                           -fx-cursor: hand;"
                    onMouseEntered="#handleMouseEntered"
                    onMouseExited="#handleMouseExited">
                <VBox.margin><Insets bottom="4"/></VBox.margin>
            </Button>

            <Button text="📄   My Documents" maxWidth="Infinity"
                    onAction="#goToMyDocuments"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #555555;
                           -fx-font-size: 13px;
                           -fx-background-radius: 8;
                           -fx-padding: 11 16;
                           -fx-alignment: CENTER_LEFT;
                           -fx-cursor: hand;"
                    onMouseEntered="#handleMouseEntered"
                    onMouseExited="#handleMouseExited">
                <VBox.margin><Insets bottom="4"/></VBox.margin>
            </Button>

            <Button text="📝   Request Document" maxWidth="Infinity"
                    style="-fx-background-color: #2d2d2d;
                           -fx-text-fill: #ffffff;
                           -fx-font-size: 13px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-padding: 11 16;
                           -fx-alignment: CENTER_LEFT;
                           -fx-cursor: hand;">
                <VBox.margin><Insets bottom="16"/></VBox.margin>
            </Button>

            <Label text="SERVICES"
                   style="-fx-font-size: 10px; -fx-font-weight: bold;
                          -fx-text-fill: #bbbbbb; -fx-padding: 8 12 6 12;"/>

            <Button text="💳   Payments" maxWidth="Infinity"
                    onAction="#goToPayments"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #555555;
                           -fx-font-size: 13px;
                           -fx-background-radius: 8;
                           -fx-padding: 11 16;
                           -fx-alignment: CENTER_LEFT;
                           -fx-cursor: hand;"
                    onMouseEntered="#handleMouseEntered"
                    onMouseExited="#handleMouseExited">
                <VBox.margin><Insets bottom="4"/></VBox.margin>
            </Button>

            <Button text="📢   My Complaints" maxWidth="Infinity"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #555555;
                           -fx-font-size: 13px;
                           -fx-background-radius: 8;
                           -fx-padding: 11 16;
                           -fx-alignment: CENTER_LEFT;
                           -fx-cursor: hand;"
                    onMouseEntered="#handleMouseEntered"
                    onMouseExited="#handleMouseExited">
                <VBox.margin><Insets bottom="4"/></VBox.margin>
            </Button>

            <Button text="📣   Announcements" maxWidth="Infinity"
                    onAction="#goToAnnouncements"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #555555;
                           -fx-font-size: 13px;
                           -fx-background-radius: 8;
                           -fx-padding: 11 16;
                           -fx-alignment: CENTER_LEFT;
                           -fx-cursor: hand;"
                    onMouseEntered="#handleMouseEntered"
                    onMouseExited="#handleMouseExited">
                <VBox.margin><Insets bottom="16"/></VBox.margin>
            </Button>

            <Label text="ACCOUNT"
                   style="-fx-font-size: 10px; -fx-font-weight: bold;
                          -fx-text-fill: #bbbbbb; -fx-padding: 8 12 6 12;"/>

            <Button text="👤   My Profile" maxWidth="Infinity"
                    onAction="#goToMyProfile"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #555555;
                           -fx-font-size: 13px;
                           -fx-background-radius: 8;
                           -fx-padding: 11 16;
                           -fx-alignment: CENTER_LEFT;
                           -fx-cursor: hand;"
                    onMouseEntered="#handleMouseEntered"
                    onMouseExited="#handleMouseExited">
                <VBox.margin><Insets bottom="4"/></VBox.margin>
            </Button>

            <!-- Spacer to push Settings to bottom -->
            <Region VBox.vgrow="ALWAYS"/>

            <Button text="⚙   Settings" maxWidth="Infinity"
                    onAction="#goToSettings"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #555555;
                           -fx-font-size: 13px;
                           -fx-background-radius: 8;
                           -fx-padding: 11 16;
                           -fx-alignment: CENTER_LEFT;
                           -fx-cursor: hand;"
                    onMouseEntered="#handleMouseEntered"
                    onMouseExited="#handleMouseExited">
                <VBox.margin><Insets bottom="4"/></VBox.margin>
            </Button>

        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: #f4f4f4;
                           -fx-background: #f4f4f4;
                           -fx-border-color: transparent;">
            <VBox spacing="20" style="-fx-padding: 24;">

                <!-- Header -->
                <VBox spacing="8">
                    <Label text="Request Document"
                           style="-fx-font-size: 24px; -fx-font-weight: bold;
                                  -fx-text-fill: #1a1a1a;"/>
                    <Label text="Submit a request for barangay documents and certificates"
                           style="-fx-font-size: 13px; -fx-text-fill: #888888;"/>
                </VBox>

                <!-- Document Type Selection -->
                <VBox style="-fx-background-color: #ffffff;
                             -fx-background-radius: 12;
                             -fx-border-color: #eeeeee;
                             -fx-border-width: 1;
                             -fx-padding: 24;"
                      spacing="16">
                    
                    <Label text="Select Document Type"
                           style="-fx-font-size: 16px; -fx-font-weight: bold;
                                  -fx-text-fill: #1a1a1a;"/>

                    <HBox spacing="12">
                        <VBox spacing="12" HBox.hgrow="ALWAYS">
                            <ToggleButton fx:id="clearanceBtn" text="📄 Barangay Clearance" maxWidth="Infinity"
                                          onAction="#handleDocumentTypeSelection"
                                          style="-fx-background-color: #f8f9fa;
                                                 -fx-text-fill: #495057;
                                                 -fx-font-size: 13px;
                                                 -fx-background-radius: 8;
                                                 -fx-border-radius: 8;
                                                 -fx-border-color: #dee2e6;
                                                 -fx-border-width: 1;
                                                 -fx-padding: 16;
                                                 -fx-alignment: CENTER_LEFT;
                                                 -fx-cursor: hand;"/>
                        </VBox>

                        <VBox spacing="12" HBox.hgrow="ALWAYS">
                            <ToggleButton fx:id="residencyBtn" text="🏠 Certificate of Residency" maxWidth="Infinity"
                                          onAction="#handleDocumentTypeSelection"
                                          style="-fx-background-color: #f8f9fa;
                                                 -fx-text-fill: #495057;
                                                 -fx-font-size: 13px;
                                                 -fx-background-radius: 8;
                                                 -fx-border-radius: 8;
                                                 -fx-border-color: #dee2e6;
                                                 -fx-border-width: 1;
                                                 -fx-padding: 16;
                                                 -fx-alignment: CENTER_LEFT;
                                                 -fx-cursor: hand;"/>
                        </VBox>

                        <VBox spacing="12" HBox.hgrow="ALWAYS">
                            <ToggleButton fx:id="indigencyBtn" text="💰 Certificate of Indigency" maxWidth="Infinity"
                                          onAction="#handleDocumentTypeSelection"
                                          style="-fx-background-color: #f8f9fa;
                                                 -fx-text-fill: #495057;
                                                 -fx-font-size: 13px;
                                                 -fx-background-radius: 8;
                                                 -fx-border-radius: 8;
                                                 -fx-border-color: #dee2e6;
                                                 -fx-border-width: 1;
                                                 -fx-padding: 16;
                                                 -fx-alignment: CENTER_LEFT;
                                                 -fx-cursor: hand;"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Dynamic Form -->
                <VBox fx:id="formContainer" style="-fx-background-color: #ffffff;
                                                   -fx-background-radius: 12;
                                                   -fx-border-color: #eeeeee;
                                                   -fx-border-width: 1;
                                                   -fx-padding: 24;"
                      spacing="20" visible="false">
                    
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label fx:id="formTitle" text="Document Request Form"
                               style="-fx-font-size: 16px; -fx-font-weight: bold;
                                      -fx-text-fill: #1a1a1a;"
                               HBox.hgrow="ALWAYS"/>
                        <Label text="⚠️ All fields are required"
                               style="-fx-font-size: 11px; -fx-text-fill: #f59e0b;
                                      -fx-background-color: #fff8e1;
                                      -fx-background-radius: 4;
                                      -fx-padding: 4 8;"/>
                    </HBox>

                    <GridPane fx:id="formGrid" hgap="20" vgap="16">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" minWidth="250"/>
                            <ColumnConstraints hgrow="ALWAYS" minWidth="250"/>
                        </columnConstraints>
                    </GridPane>

                    <HBox spacing="12" style="-fx-padding: 16 0 0 0;">
                        <Button fx:id="submitBtn" text="Submit Request" onAction="#handleSubmitRequest"
                                style="-fx-background-color: #2d2d2d;
                                       -fx-text-fill: #ffffff;
                                       -fx-font-size: 13px;
                                       -fx-font-weight: bold;
                                       -fx-background-radius: 8;
                                       -fx-padding: 12 24;
                                       -fx-cursor: hand;"/>
                        <Button text="Clear Form" onAction="#handleClearForm"
                                style="-fx-background-color: #f4f4f4;
                                       -fx-text-fill: #555555;
                                       -fx-font-size: 13px;
                                       -fx-background-radius: 8;
                                       -fx-padding: 12 24;
                                       -fx-cursor: hand;"/>
                        <Label text="💡 Tip: Make sure all information is accurate before submitting"
                               style="-fx-font-size: 11px; -fx-text-fill: #666666;
                                      -fx-padding: 12 0;"
                               HBox.hgrow="ALWAYS"/>
                    </HBox>

                    <Label fx:id="statusLabel" text="" wrapText="true"
                           style="-fx-font-size: 12px; -fx-padding: 8 0 0 0;"/>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
