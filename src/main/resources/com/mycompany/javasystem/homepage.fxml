<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:id="scrollPane"
            fx:controller="com.mycompany.javasystem.HomepageController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            style="-fx-background-color: #f5f5f0; -fx-background: #f5f5f0;"
            prefWidth="1366" prefHeight="768">

    <VBox maxWidth="Infinity" fillWidth="true">

        <!-- ═══ HERO SECTION ═══ -->
        <StackPane fx:id="heroPane" prefHeight="${scrollPane.height}" minHeight="500">

            <!-- Background image -->
            <ImageView fx:id="heroBg" preserveRatio="false" smooth="true" mouseTransparent="true"
                       fitWidth="${heroPane.width}" fitHeight="${heroPane.height}">
                <image><Image url="@BACKGROUND.png"/></image>
            </ImageView>

            <!-- Dark gradient overlay -->
            <Pane fx:id="heroOverlay" mouseTransparent="true"
                  style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, rgba(0,0,0,0.52), rgba(0,20,30,0.48), rgba(0,0,0,0.62));"/>

            <!-- Hero content -->
            <VBox alignment="CENTER" spacing="0">
                <padding><Insets top="0" bottom="0" left="20" right="20"/></padding>

                <!-- Eyebrow badge -->
                <Label text="Official Digital Portal"
                       style="-fx-font-size: 11px; -fx-font-weight: bold;
                              -fx-text-fill: #29b6cf;
                              -fx-background-color: rgba(41,182,207,0.08);
                              -fx-border-color: rgba(41,182,207,0.4);
                              -fx-border-width: 1; -fx-border-radius: 20;
                              -fx-background-radius: 20;
                              -fx-padding: 5 14;">
                    <VBox.margin><Insets bottom="20"/></VBox.margin>
                </Label>

                <!-- Main title -->
                <Label text="Barangay San Isidro"
                       style="-fx-font-size: 72px; -fx-font-weight: bold;
                              -fx-text-fill: #29b6cf;
                              -fx-effect: dropshadow(gaussian, rgba(41,182,207,0.3), 40, 0, 0, 4);">
                    <VBox.margin><Insets bottom="12"/></VBox.margin>
                </Label>

                <!-- Subtitle -->
                <Label text="INTEGRATED MANAGEMENT SYSTEM"
                       style="-fx-font-size: 13px; -fx-font-weight: 500;
                              -fx-text-fill: rgba(255,255,255,0.85);
                              -fx-letter-spacing: 3px;">
                    <VBox.margin><Insets bottom="16"/></VBox.margin>
                </Label>

                <!-- Description -->
                <Label text="Streamline barangay operations with resident management, document requests, complaint tracking, and financial management."
                       wrapText="true" maxWidth="540" textAlignment="CENTER"
                       style="-fx-font-size: 14px; -fx-text-fill: rgba(255,255,255,0.75); -fx-line-spacing: 4;">
                    <VBox.margin><Insets bottom="40"/></VBox.margin>
                </Label>

                <!-- Action buttons -->
                <HBox alignment="CENTER" spacing="14">
                    <VBox.margin><Insets bottom="18"/></VBox.margin>
                    <Button text="Sign In" onAction="#openLogin"
                            style="-fx-background-color: #29b6cf;
                                   -fx-text-fill: white;
                                   -fx-font-size: 12px; -fx-font-weight: bold;
                                   -fx-padding: 14 40;
                                   -fx-background-radius: 40;
                                   -fx-border-radius: 40;
                                   -fx-cursor: hand;
                                   -fx-effect: dropshadow(gaussian, rgba(41,182,207,0.35), 32, 0, 0, 8);"/>
                </HBox>

                <!-- Register link -->
                <HBox alignment="CENTER" spacing="4">
                    <Label text="Don't have an account?"
                           style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.5);"/>
                    <Hyperlink text="Register Here" onAction="#openRegister"
                               style="-fx-text-fill: #29b6cf; -fx-font-size: 13px;
                                      -fx-font-weight: bold; -fx-border-color: transparent;"/>
                </HBox>
            </VBox>

            <!-- Scroll hint -->
            <VBox alignment="BOTTOM_CENTER" StackPane.alignment="BOTTOM_CENTER" mouseTransparent="true">
                <padding><Insets bottom="28"/></padding>
                <Label text="▼  scroll"
                       style="-fx-font-size: 10px; -fx-text-fill: rgba(255,255,255,0.35);
                              -fx-letter-spacing: 2px;"/>
            </VBox>
        </StackPane>

        <!-- ═══ FEATURES SECTION ═══ -->
        <VBox fx:id="featuresSection" style="-fx-background-color: #eeede5;" spacing="0">
            <padding><Insets top="96" bottom="80" left="40" right="40"/></padding>

            <!-- Section header (centered) -->
            <Label text="Key Features" maxWidth="Infinity" textAlignment="CENTER"
                   style="-fx-font-size: 42px; -fx-font-weight: bold;
                          -fx-text-fill: #2c2416; -fx-alignment: center;">
                <VBox.margin><Insets bottom="60"/></VBox.margin>
            </Label>

            <!-- Features grid centered wrapper -->
            <HBox alignment="CENTER">
                <VBox spacing="22" maxWidth="1100">

                    <!-- Row 1 -->
                    <HBox spacing="22">

                        <!-- Card 1: Resident Management -->
                        <VBox HBox.hgrow="ALWAYS" spacing="0"
                              style="-fx-background-color: white; -fx-background-radius: 18;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 16, 0, 0, 2);">
                            <padding><Insets top="32" bottom="32" left="28" right="28"/></padding>
                            <StackPane prefWidth="48" prefHeight="48"
                                       style="-fx-background-color: rgba(41,182,207,0.12); -fx-background-radius: 12;">
                                <VBox.margin><Insets bottom="20"/></VBox.margin>
                                <javafx.scene.shape.SVGPath
                                    content="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2 M15 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0 M23 21v-2a4 4 0 0 0-3-3.87 M16 3.13a4 4 0 0 1 0 7.75"
                                    style="-fx-stroke: #29b6cf; -fx-stroke-width: 1.8; -fx-fill: transparent;"/>
                            </StackPane>
                            <Label text="Resident Management"
                                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2c2416;">
                                <VBox.margin><Insets bottom="8"/></VBox.margin>
                            </Label>
                            <Label text="Manage resident records, household data, and demographic information efficiently."
                                   wrapText="true"
                                   style="-fx-font-size: 13px; -fx-text-fill: #5a4e3a; -fx-line-spacing: 3;"/>
                        </VBox>

                        <!-- Card 2: Document Requests -->
                        <VBox HBox.hgrow="ALWAYS" spacing="0"
                              style="-fx-background-color: white; -fx-background-radius: 18;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 16, 0, 0, 2);">
                            <padding><Insets top="32" bottom="32" left="28" right="28"/></padding>
                            <StackPane prefWidth="48" prefHeight="48"
                                       style="-fx-background-color: rgba(41,182,207,0.12); -fx-background-radius: 12;">
                                <VBox.margin><Insets bottom="20"/></VBox.margin>
                                <javafx.scene.shape.SVGPath
                                    content="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M16 13H8 M16 17H8 M10 9H9H8"
                                    style="-fx-stroke: #29b6cf; -fx-stroke-width: 1.8; -fx-fill: transparent;"/>
                            </StackPane>
                            <Label text="Document Requests"
                                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2c2416;">
                                <VBox.margin><Insets bottom="8"/></VBox.margin>
                            </Label>
                            <Label text="Process barangay certificates with online payment integration for GCash and PayMaya."
                                   wrapText="true"
                                   style="-fx-font-size: 13px; -fx-text-fill: #5a4e3a; -fx-line-spacing: 3;"/>
                        </VBox>

                        <!-- Card 3: Complaint Tracking -->
                        <VBox HBox.hgrow="ALWAYS" spacing="0"
                              style="-fx-background-color: white; -fx-background-radius: 18;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 16, 0, 0, 2);">
                            <padding><Insets top="32" bottom="32" left="28" right="28"/></padding>
                            <StackPane prefWidth="48" prefHeight="48"
                                       style="-fx-background-color: rgba(41,182,207,0.12); -fx-background-radius: 12;">
                                <VBox.margin><Insets bottom="20"/></VBox.margin>
                                <javafx.scene.shape.SVGPath
                                    content="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z M12 8v4 M12 16h.01"
                                    style="-fx-stroke: #29b6cf; -fx-stroke-width: 1.8; -fx-fill: transparent;"/>
                            </StackPane>
                            <Label text="Complaint Tracking"
                                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2c2416;">
                                <VBox.margin><Insets bottom="8"/></VBox.margin>
                            </Label>
                            <Label text="Track and resolve community complaints with priority levels and status updates."
                                   wrapText="true"
                                   style="-fx-font-size: 13px; -fx-text-fill: #5a4e3a; -fx-line-spacing: 3;"/>
                        </VBox>
                    </HBox>

                    <!-- Row 2 -->
                    <HBox spacing="22">

                        <!-- Card 4: Financial Management -->
                        <VBox HBox.hgrow="ALWAYS" spacing="0"
                              style="-fx-background-color: white; -fx-background-radius: 18;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 16, 0, 0, 2);">
                            <padding><Insets top="32" bottom="32" left="28" right="28"/></padding>
                            <StackPane prefWidth="48" prefHeight="48"
                                       style="-fx-background-color: rgba(41,182,207,0.12); -fx-background-radius: 12;">
                                <VBox.margin><Insets bottom="20"/></VBox.margin>
                                <javafx.scene.shape.SVGPath
                                    content="M12 1v22 M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"
                                    style="-fx-stroke: #29b6cf; -fx-stroke-width: 1.8; -fx-fill: transparent;"/>
                            </StackPane>
                            <Label text="Financial Management"
                                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2c2416;">
                                <VBox.margin><Insets bottom="8"/></VBox.margin>
                            </Label>
                            <Label text="Monitor revenue, expenses, and generate comprehensive financial reports."
                                   wrapText="true"
                                   style="-fx-font-size: 13px; -fx-text-fill: #5a4e3a; -fx-line-spacing: 3;"/>
                        </VBox>

                        <!-- Card 5: Announcements -->
                        <VBox HBox.hgrow="ALWAYS" spacing="0"
                              style="-fx-background-color: white; -fx-background-radius: 18;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 16, 0, 0, 2);">
                            <padding><Insets top="32" bottom="32" left="28" right="28"/></padding>
                            <StackPane prefWidth="48" prefHeight="48"
                                       style="-fx-background-color: rgba(41,182,207,0.12); -fx-background-radius: 12;">
                                <VBox.margin><Insets bottom="20"/></VBox.margin>
                                <javafx.scene.shape.SVGPath
                                    content="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.84A16 16 0 0 0 15.1 16l.95-.95a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 17z"
                                    style="-fx-stroke: #29b6cf; -fx-stroke-width: 1.8; -fx-fill: transparent;"/>
                            </StackPane>
                            <Label text="Announcements"
                                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2c2416;">
                                <VBox.margin><Insets bottom="8"/></VBox.margin>
                            </Label>
                            <Label text="Post community announcements with categories for events, alerts, and news."
                                   wrapText="true"
                                   style="-fx-font-size: 13px; -fx-text-fill: #5a4e3a; -fx-line-spacing: 3;"/>
                        </VBox>

                        <!-- Card 6: User Management -->
                        <VBox HBox.hgrow="ALWAYS" spacing="0"
                              style="-fx-background-color: white; -fx-background-radius: 18;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 16, 0, 0, 2);">
                            <padding><Insets top="32" bottom="32" left="28" right="28"/></padding>
                            <StackPane prefWidth="48" prefHeight="48"
                                       style="-fx-background-color: rgba(41,182,207,0.12); -fx-background-radius: 12;">
                                <VBox.margin><Insets bottom="20"/></VBox.margin>
                                <javafx.scene.shape.SVGPath
                                    content="M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z M19.07 4.93a10 10 0 0 1 0 14.14 M4.93 4.93a10 10 0 0 0 0 14.14"
                                    style="-fx-stroke: #29b6cf; -fx-stroke-width: 1.8; -fx-fill: transparent;"/>
                            </StackPane>
                            <Label text="User Management"
                                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2c2416;">
                                <VBox.margin><Insets bottom="8"/></VBox.margin>
                            </Label>
                            <Label text="Manage staff accounts and user roles with comprehensive audit logging."
                                   wrapText="true"
                                   style="-fx-font-size: 13px; -fx-text-fill: #5a4e3a; -fx-line-spacing: 3;"/>
                        </VBox>
                    </HBox>

                </VBox>
            </HBox>

            <!-- Footer -->
            <Separator style="-fx-background-color: rgba(0,0,0,0.07);">
                <VBox.margin><Insets top="72" bottom="32"/></VBox.margin>
            </Separator>
            <Label text="© 2026 Barangay San Isidro Management System. All rights reserved."
                   style="-fx-font-size: 12px; -fx-text-fill: #9a8e7a; -fx-font-weight: 500;"
                   maxWidth="Infinity" textAlignment="CENTER"/>
        </VBox>

    </VBox>
</ScrollPane>
